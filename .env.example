# Este archivo contiene únicamente opciones avanzadas. El portal arranca sin
# copiarlo: solo requiere secrets/oracle_password.txt.
DEBUG=False
SECRET_KEY=
ALLOWED_HOSTS=*
DB_ENGINE=oracle
ORACLE_HOST=scan-odscbio
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=ODSCBIO
ORACLE_USER=USRFACDOC
# Alternativas avanzadas al archivo secrets/oracle_password.txt. Déjalas vacías
# para que el portal lea la contraseña desde ese archivo.
ORACLE_PASSWORD=
ORACLE_PASSWORD_B64=
ORACLE_PASSWORD_FILE=secrets/oracle_password.txt
# ORACLE_DSN permite sustituir host:puerto/servicio por un descriptor completo.
ORACLE_DSN=
ORACLE_POOL=true
AUTO_MIGRATE=true
CLOSED_STATUS_CODE=T
DUE_SOON_DAYS=7
ALLOW_EARLIER_RESCHEDULE=false
COOKIE_SECURE=false

# Teams Workflows: pegar la URL privada del flujo para el chat 4DX.
TEAMS_WEBHOOK_URL=
# URL del servidor para los enlaces de reportes y notificaciones.
PORTAL_PUBLIC_URL=

CORREO_SSH_HOST=
CORREO_SSH_USER=
CORREO_SSH_PASSWORD=

# Opciones de dominio/HTTPS para cuando exista un proxy corporativo.
CSRF_TRUSTED_ORIGINS=
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HTTPS=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false
