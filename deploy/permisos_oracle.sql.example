-- Ejecutar como DBA y ajustar el tablespace antes del pase.
-- Las tablas pertenecen al usuario de sesión USRVALCBIO; USRFACDOC es el proxy.

GRANT CREATE SESSION TO USRVALCBIO;
GRANT CREATE TABLE TO USRVALCBIO;
GRANT CREATE SEQUENCE TO USRVALCBIO;
GRANT CREATE PROCEDURE TO USRVALCBIO;
GRANT CREATE TRIGGER TO USRVALCBIO;

-- Sustituir TABLESPACE_4DX por el tablespace autorizado para el esquema.
-- ALTER USER USRVALCBIO QUOTA UNLIMITED ON TABLESPACE_4DX;

-- Normalmente están concedidos a PUBLIC; ejecutar solo si la política los retiró.
-- GRANT EXECUTE ON SYS.DBMS_LOB TO USRVALCBIO;
-- GRANT EXECUTE ON SYS.DBMS_RANDOM TO USRVALCBIO;
